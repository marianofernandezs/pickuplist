# Para ejecución full Docker Compose usa el archivo de raíz `.env.docker.example`.
# Este `.env.example` está pensado para ejecutar backend local (sin Docker).
ENVIRONMENT=development
APP_NAME=VIGE API
APP_HOST=0.0.0.0
APP_PORT=8000
API_DOCS_ENABLED=true
DATABASE_URL=sqlite:///./vige.db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS_REDIRECT=false
MAX_PDFS_PER_BATCH=70
UPLOAD_CHUNK_SIZE_BYTES=1048576
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=8
CELERY_MAX_TASKS_PER_CHILD=50

# Seguridad
AUTH_JWT_SECRET_KEY=cambia-esto-en-produccion
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30

# En desarrollo local puedes activar true para ver token/link de reset en response.
AUTH_DEBUG_RETURN_RESET_TOKEN=false

# Lista de usuarios autorizados (recomendado en producción)
# AUTH_ALLOWED_EMAILS=admin@empresa.cl,bodega@empresa.cl
