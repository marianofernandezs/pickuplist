# Docker Compose - entorno local para cliente
# Copia este archivo a .env en la raíz del proyecto.

ENVIRONMENT=development
APP_NAME=VIGE API
API_DOCS_ENABLED=true

POSTGRES_DB=vige
POSTGRES_USER=vige
POSTGRES_PASSWORD=vige_dev_password

FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS_REDIRECT=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

MAX_PDFS_PER_BATCH=70
CELERY_WORKER_CONCURRENCY=8
CELERY_MAX_TASKS_PER_CHILD=50

AUTH_JWT_SECRET_KEY=change-me-in-production
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_DEBUG_RETURN_RESET_TOKEN=false
# AUTH_ALLOWED_EMAILS=ventas@aricaplast.cl,bodega@aricaplast.cl
